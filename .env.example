# ============================================================================
# Supabase 配置
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://tjbnjrcgmyiwudqptfhc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# 存储桶配置
# ============================================================================
STORAGE_QUOTE_BUCKET=quote-files
STORAGE_KNOWLEDGE_BUCKET=knowledge-base

# ============================================================================
# 应用配置
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:5000
NODE_ENV=production

# ============================================================================
# Session Token 签名密钥（必须配置，用于 HMAC 签发/验证用户 session token）
# 生成方式：openssl rand -base64 48
# ============================================================================
SESSION_TOKEN_SECRET=please_generate_a_strong_random_secret_at_least_32_chars

# ============================================================================
# 短信服务配置（注册手机号验证码，防虚假注册 + 注册成功通知短信）
# SMS_PROVIDER: mock | aliyun | tencent
#   - mock（默认）：不真实发送，验证码打印到服务端日志；
#     SMS_MOCK_RETURN_CODE=true 且非生产环境时，验证码随 API 响应返回，便于本地联调
#   - aliyun：阿里云短信（需 SMS_ACCESS_KEY_ID / SMS_ACCESS_KEY_SECRET / SMS_SIGN_NAME / SMS_TEMPLATE_CODE）
#   - tencent：腾讯云短信（还需 SMS_SDK_APP_ID）
# 环境变量兼容双前缀：腾讯云也可用 TENCENT_SMS_*（TENCENT_SMS_SECRET_ID / TENCENT_SMS_SECRET_KEY /
#   TENCENT_SMS_SDK_APP_ID / TENCENT_SMS_SIGN_NAME / TENCENT_SMS_TEMPLATE_ID /
#   TENCENT_SMS_NOTIFY_TEMPLATE_ID），TENCENT_SMS_* 优先于 SMS_*
# 注意：腾讯云 SignName 参数必须填「签名内容」（如：兴燊环境技术深圳），不是签名 ID（数字）
# SMS_NOTIFY_TEMPLATE_CODE/TENCENT_SMS_NOTIFY_TEMPLATE_ID：注册成功通知短信模板（模板无占位符）
# 生产环境防虚假注册必须配置真实短信渠道，否则用户收不到验证码将无法注册
# 阿里云短信模板变量名固定为 code；腾讯云模板参数按占位符顺序填充
# ============================================================================
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_SDK_APP_ID=
SMS_NOTIFY_TEMPLATE_CODE=
SMS_REGION=cn-hangzhou
SMS_MOCK_RETURN_CODE=true
SMS_CODE_TTL_SECONDS=300
SMS_MAX_ATTEMPTS=5
# 腾讯云 TENCENT_SMS_* 别名（与 SMS_* 二选一即可，同时配置时 TENCENT_SMS_* 优先）
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_NOTIFY_TEMPLATE_ID=

# ============================================================================
# 微信 OAuth 配置（PC 扫码登录 + 账号绑定）
# WECHAT_OAUTH_APP_ID / WECHAT_OAUTH_APP_SECRET：
#   微信开放平台（open.weixin.qq.com）→ 网站应用 → 开发信息 查看
#   兼容旧命名 WECHAT_APP_ID / WECHAT_APP_SECRET，同时配置时 WECHAT_OAUTH_* 优先
# WECHAT_ENABLED：显式设 false 时即使凭据存在也禁用微信登录（默认凭据存在即启用）
# WECHAT_REDIRECT_URI：回调地址，须与微信开放平台「授权回调域」一致
#   （未配置时使用 ${NEXT_PUBLIC_BASE_URL}/api/auth/callback/wechat）
#   ⚠️ 凭据留空时 oauth-url 返回 503，前端自动降级显示「微信登录暂未开通」
# 公众号 JS-SDK（可选，当前版本未使用）：
#   WECHAT_MP_APP_ID / WECHAT_MP_APP_SECRET
# ============================================================================
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
WECHAT_ENABLED=true
WECHAT_REDIRECT_URI=
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_MP_APP_ID=
# WECHAT_MP_APP_SECRET=

# ============================================================================
# 微信支付配置（APIv3，Native 扫码充值）
# 开通路径：pay.weixin.qq.com → 产品中心 → Native 支付；APIv3 密钥在商户平台「API 安全」设置
# WECHAT_MCHID：微信支付商户号（10 位数字）
# WECHAT_APPID：公众号/小程序/开放平台 AppID（与 Native 支付绑定的 appid）
# WECHAT_API_V3_KEY：APIv3 密钥（32 位，数字+大小写字母，回调解密与回调解密兜底依赖它）
# WECHAT_CERT_SERIAL_NO：APIv3 商户证书序列号（商户平台 → API 安全 → 查看证书序列号）
# WECHAT_PRIVATE_KEY：APIv3 商户私钥 apiclient_key.pem 内容（复制后用 \n 替换换行符，即字面 \n）
# WECHAT_NOTIFY_URL：支付回调地址（需外网可访问，域名须与商户平台回调配置一致）
# WECHAT_PLATFORM_PUBLIC_KEY（可选，强烈建议）：微信支付平台证书公钥（PEM），配置后回调执行 RSA 验签；
#   未配置时以 APIv3 密钥 AEAD 解密成功作为安全兜底（只有微信平台与商户持有 APIv3 密钥，无法伪造）
# ============================================================================
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=
# WECHAT_PLATFORM_PUBLIC_KEY=

# ============================================================================
# 积分充值套餐（可选，配置后优先于后台兑换比例动态套餐）
# 格式：积分:价格_积分:价格（价格单位：元），下划线分隔多个套餐
# 示例：1000 积分 = 10 元，5000 积分 = 50 元 ...
# 未配置时回退到后台「积分兑换规则」（site_config）按 1 元 = N 积分 动态生成
# ============================================================================
# RECHARGE_PLANS=1000:10_5000:50_10000:100_20000:200_50000:500

# ============================================================================
# AI 服务配置
# ============================================================================
# DeepSeek（主力 LLM，用于对话理解、技术方案、报价生成）
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Gemini（通过 LaoZhang.ai 中转，可用于对话）
LAOZHANG_API_KEY=your_laozhang_key_here
LAOZHANG_BASE_URL=https://api.laozhang.ai/v1
LAOZHANG_MODEL=gemini-2.5-flash

# Coze 工具（联网搜索、向量搜索、生图）
COZE_API_KEY=your_coze_key_here
ENABLE_COZE_TOOLS=false
ENABLE_COZE_WEB_SEARCH=false
ENABLE_COZE_EMBEDDING=false
ENABLE_COZE_IMAGE_GENERATION=false

# DeepSeek V4 Pro（旗舰推理模型，复杂报价和技术方案）
DEEPSEEK_V4_PRO_API_KEY=sk-your-deepseek-v4-pro-key
DEEPSEEK_V4_PRO_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_V4_PRO_MODEL=deepseek-chat

# GLM-5.2 High（中文理解顶级，适合中文专业场景和技术方案）
GLM_API_KEY=your-glm-key
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-5.2

# MiniMax M2 Her（联网搜索，市场行情对比）
MINIMAX_M2_HER_API_KEY=your-minimax-key
MINIMAX_M2_HER_API_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_M2_HER_MODEL=minimax-m2-her

# Kimi K2.7 Code（代码优化和结构化数据）
KIMI_K2_7_CODE_API_KEY=sk-your-kimi-key
KIMI_K2_7_CODE_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_K2_7_CODE_MODEL=moonshot-v1-8k

# 八爪鱼 RPA（网页数据采集）
OCTOPUS_RPA_API_KEY=your-octopus-key
OCTOPUS_RPA_API_URL=https://mcp.bazhuayu.com

# ============================================================================
# OCR 服务配置（RapidOCR 中文识别，Docker 内网部署）
# ============================================================================
# OCR Service 地址（Docker Compose 内网默认 http://ocr-service:8000；
# 本地开发连不上容器时可用 host.docker.internal 或宿主机 IP）
OCR_SERVICE_URL=http://ocr-service:8000
# ============================================================================
# 混合驱动方案生成（#[20260827-1030]-6）
# ============================================================================
# 知识库开关（true 启用向量检索增强；false 使用专家规则层兜底）
ENABLE_KNOWLEDGE_BASE=false
# 规则引擎配置（可调系数）
EQUIPMENT_PRICE_FACTOR=1.0
LABOR_COST_FACTOR=1.0


# ============================================================================
# 数据查询优先级（#[20260827-1030]-7 数据持久化与动态关联架构）
# 价格决策链路：1️⃣产品价格库 → 2️⃣定额库 → 3️⃣联网搜索 → 4️⃣规则估算（标注"估算价，待核实"）
# ============================================================================
# PRICE_PRIORITY: product_db_first | quota_first | mixed
PRICE_PRIORITY=product_db_first
# 联网搜索开关（true 时 DB 未命中价格走联网检索）
ENABLE_ONLINE_SEARCH=true
# ONLINE_SEARCH_PROVIDER: coze | web-search | auto（统一走 searchWeb 多供应商链路）
ONLINE_SEARCH_PROVIDER=auto
# 数据来源标注开关（方案末尾附"数据来源"表，标注每个价格/资料的来源）
ENABLE_DATA_SOURCE_TRACKING=true
