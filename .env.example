NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRqYm5qcmNnbXlpd3VkcXB0ZmhjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDA0NzU4MjEsImV4cCI6MjA1NjA1MTgyMX0.4F_VYKTlgUpr_RjG2wqqCR4FeLh4OaFw3LpoZzKcMqU
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_TOKEN

# ============================================================================
# 存储桶配置
# ============================================================================
STORAGE_QUOTE_BUCKET=quote-files
STORAGE_KNOWLEDGE_BUCKET=knowledge-base

# ============================================================================
# 应用配置
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:5000
NODE_ENV=production

# ============================================================================
# Session Token 签名密钥（必须配置，用于 HMAC 签发/验证用户 session token）
# 生成方式：openssl rand -base64 48
# ============================================================================
SESSION_TOKEN_SECRET=please_generate_a_strong_random_secret_at_least_32_chars

# ============================================================================
# AI 服务配置
# ============================================================================
# DeepSeek（主力 LLM，用于对话理解、技术方案、报价生成）
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Gemini（通过 LaoZhang.ai 中转，可用于对话）
LAOZHANG_API_KEY=your_laozhang_key_here
LAOZHANG_BASE_URL=https://api.laozhang.ai/v1
LAOZHANG_MODEL=gemini-2.5-flash

# Coze 工具（联网搜索、向量搜索、生图）
COZE_API_KEY=your_coze_key_here
ENABLE_COZE_TOOLS=false
ENABLE_COZE_WEB_SEARCH=false
ENABLE_COZE_EMBEDDING=false
ENABLE_COZE_IMAGE_GENERATION=false

# DeepSeek V4 Pro（旗舰推理模型，复杂报价和技术方案）
DEEPSEEK_V4_PRO_API_KEY=YOUR_API_KEY
DEEPSEEK_V4_PRO_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_V4_PRO_MODEL=deepseek-chat

# GLM-5.2 High（中文理解顶级，适合中文专业场景和技术方案）
GLM_API_KEY=your-glm-key
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-5.2

# MiniMax M2 Her（联网搜索，市场行情对比）
MINIMAX_M2_HER_API_KEY=your-minimax-key
MINIMAX_M2_HER_API_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_M2_HER_MODEL=minimax-m2-her

# Kimi K2.7 Code（代码优化和结构化数据）
KIMI_K2_7_CODE_API_KEY=sk-your-kimi-key
KIMI_K2_7_CODE_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_K2_7_CODE_MODEL=moonshot-v1-8k

# 八爪鱼 RPA（网页数据采集）
OCTOPUS_RPA_API_KEY=your-octopus-key
OCTOPUS_RPA_API_URL=https://mcp.bazhuayu.com

# ============================================================================
# 系统配置
# ============================================================================
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_LIMIT_PER_DAY=10
QUOTA_FREE_TIER=5  # 免费用户每天可生成报价次数