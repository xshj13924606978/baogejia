      margin-bottom: 12pt;
      padding-left: 10pt;
      border-left: 3px solid #60a5fa;
      page-break-after: avoid;
    }
    
    /* 段落样式 - 简洁 */
    p {
      margin-bottom: 12pt;
      text-align: justify;
      text-indent: 2em;
