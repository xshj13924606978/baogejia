      font-size: 11pt;
      color: #333;
      vertical-align: middle;
    }

    tr:nth-child(even) {
      background-color: #f8fafc;
    }

    tr:nth-child(odd) {
      background-color: white;
    }
    
    /* 列表样式 - 简洁 */
    ul, ol {
      margin: 15pt 0;
