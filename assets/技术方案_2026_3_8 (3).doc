      padding: 0;
      background: white;
    }
    
    /* 封面样式 - 简洁商务 */
    .cover {
      text-align: center;
      padding: 80pt 0;
      page-break-after: always;
      background: #1e40af;
      color: white;
      min-height: 85vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .cover-title {
      font-size: 36pt;
      font-weight: 600;
      color: white;
      margin-bottom: 20pt;
      letter-spacing: 4pt;
    }

    .cover-subtitle {
      font-size: 18pt;
      color: rgba(255,255,255,0.9);
      margin-bottom: 60pt;
      font-weight: normal;
      letter-spacing: 2pt;
    }

    .cover-info {
      font-size: 12pt;
      color: rgba(255,255,255,0.85);
      margin-top: 50pt;
      line-height: 2;
    }

    .cover-info p {
      text-indent: 0;
      margin: 8pt 0;
      color: rgba(255,255,255,0.9);
      font-weight: normal;
    }

    .cover-logo {
      font-size: 14pt;
      font-weight: 600;
      color: white;
      margin-bottom: 12pt;
      letter-spacing: 1pt;
    }
    
    /* 页眉 - 简洁 */
    .header {
      border-bottom: 2px solid #1e40af;
      padding-bottom: 10pt;
      margin-bottom: 24pt;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header-title {
      font-size: 13pt;
      font-weight: 600;
      color: #1e40af;
    }

    .header-date {
      font-size: 11pt;
      color: #64748b;
    }
    
    /* 标题样式 - 简洁商务 */
    h1 {
      font-size: 20pt;
      font-weight: 600;
      color: #1e40af;
      margin-top: 30pt;
      margin-bottom: 20pt;
      padding-bottom: 10pt;
      border-bottom: 2px solid #3b82f6;
      text-align: center;
      page-break-after: avoid;
    }

    h2 {
      font-size: 15pt;
      font-weight: 600;
      color: #1e40af;
      margin-top: 25pt;
